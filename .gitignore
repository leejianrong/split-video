# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local Claude Code session state
.claude/

# Test artifacts
.pytest_cache/

# Personal video files / splitter output — never commit these
/videos/
*_split/

# YAMNet model assets — fetched via `make fetch-model` / the Docker build,
# not vendored (see scripts/fetch_yamnet_model.py)
/src/split_video/editor/models/

# Persisted editor analysis caches (silence/waveform/classification),
# written as sidecars next to whatever video was opened for editing
.split-video-cache/

# Optional ML models (the transcription model), downloaded into the workspace on first use
.split-video-models/

# Saved split points, written as a sidecar next to whatever video was
# opened for editing — see editor/project_store.py
*.split-video-project.json
# ...except the legacy split projects the migration tests read
!tests/fixtures/split_legacy/*.split-video-project.json

# Lock files that sit next to the project files while they are written
*.split-video-project.json.lock
*.split-video-timeline.json.lock
.split-video-locks/

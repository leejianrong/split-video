#!/bin/sh
# Fast local gate mirroring the cheap CI jobs, run before every push.
# Install once with: git config core.hooksPath .githooks
# Skip for a scoped exception with: git push --no-verify

set -e

echo "pre-push: running ruff check..."
uv run ruff check .

echo "pre-push: running ruff format --check..."
uv run ruff format --check .

# Generated files that CI's lint job checks for drift (about 2 s together). Fix with: make openapi schemas errors
echo "pre-push: checking generated files are up to date..."
uv run python scripts/export_openapi.py --check
uv run python scripts/export_edit_plan_schema.py --check
uv run python scripts/export_edit_ops_schema.py --check
uv run python scripts/export_error_catalogue.py --check

echo "pre-push: running unit tests..."
uv run pytest tests/unit
